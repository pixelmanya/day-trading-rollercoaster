# Environment variables the app reads. Copy to .env (git-ignored) and fill in locally;
# on Render, set them in the service's Environment settings. Never commit real values.

# Port of the Node server started by `pnpm start` (Render sets it automatically).
PORT=3000

# Postgres connection string. Locally: the Neon "development" branch's pooled connection string
# (…?sslmode=require), or any Postgres 16, e.g.
# postgres://trading:local-dev-only@localhost:5432/trading_log_dev
# Never production's or preview's: the server refuses them here (README → Environments).
# Without it the app still runs in guest mode; /api/health reports "not configured".
DATABASE_URL=

# Render PR previews (IS_PULL_REQUEST=true) use this instead of DATABASE_URL: the Neon
# "preview" branch, never production. Not needed locally.
PREVIEW_DATABASE_URL=

# Signs sessions and sign-in links: at least 32 random characters, different in every
# environment. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The app's public address, used in sign-in links. Optional: defaults to Render's address,
# or http://localhost:3000 in development.
BETTER_AUTH_URL=

# Sign-in emails through Brevo (brevo.com, free for 300 emails a day): an API key from
# SMTP & API → API Keys, and a sender address verified in Brevo. Optional in development,
# where sign-in links are printed in the terminal instead; set both or neither.
BREVO_API_KEY=
MAIL_FROM=
