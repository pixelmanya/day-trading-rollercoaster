{
  "name": "day-trading-rollercoaster",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm css-types && tsc -b && vite build",
    "typecheck": "pnpm css-types && tsc -b",
    "lint": "oxlint --deny-warnings && stylelint \"**/*.css\"",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "pnpm format:check && pnpm lint && pnpm knip && pnpm typecheck && pnpm test && pnpm build",
    "knip": "knip",
    "prepare": "lefthook install && node tools/generate-css-types.js",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:fix": "oxlint --fix; oxfmt; oxlint --fix; stylelint --fix \"**/*.css\"",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "css-types": "node tools/generate-css-types.js"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "31.0.0",
    "knip": "6.42.1",
    "lefthook": "2.2.2",
    "nitro": "3.0.261103-rc",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  }
}
